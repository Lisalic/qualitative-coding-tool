# Copy to deploy/.env on the VM and fill in. Never commit the real file.

# Public hostname Caddy serves and gets a certificate for. With no domain
# of your own, use the VM's public IP via sslip.io, e.g. 140-238-1-2.sslip.io
API_DOMAIN=

# Generate both with: openssl rand -hex 32
# (hex keeps the Postgres password URL-safe inside DATABASE_URL)
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Where password-reset links point.
FRONTEND_URL=https://qualitative-coding-tool.vercel.app

# Password-reset email via Brevo (optional; without it, password reset is unavailable).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
